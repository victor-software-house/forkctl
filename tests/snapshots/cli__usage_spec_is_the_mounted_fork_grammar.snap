---
source: tests/cli.rs
---
name fork
bin fork
version "<version>"
about "Maintain an explicit audited StGit downstream patch stack"
usage "Usage: fork [OPTIONS] [COMMAND]"
flag "-m --manifest" help="Manifest path; defaults to `FORK_MANIFEST` then `patches/fork.yaml`" global=#true {
    arg <MANIFEST>
}
flag "-f --format" help="Output representation" global=#true default=pretty {
    arg <OUTPUT> {
        choices pretty json
    }
}
flag "-c --color" help="Pretty-output color policy" global=#true default=auto {
    arg <COLOR> {
        choices auto always never
    }
}
flag "-q --quiet" help="Suppress successful pretty output" global=#true
cmd init help="Bootstrap a new contract or hydrate a fresh clone" {
    flag --upstream-remote help="Fetch-only upstream remote name" {
        arg <UPSTREAM_REMOTE>
    }
    flag "-u --upstream-url" help="Exact upstream repository URL" {
        arg <UPSTREAM_URL>
    }
    flag --upstream-ref help="Full upstream branch ref, such as refs/heads/main" {
        arg <UPSTREAM_REF>
    }
    flag --downstream-remote help="Downstream publication remote name" {
        arg <DOWNSTREAM_REMOTE>
    }
    flag --downstream-branch help="Managed downstream branch name" {
        arg <DOWNSTREAM_BRANCH>
    }
    flag --publish help="Default publish mode for this repository" {
        arg <PUBLISH> {
            choices rewrite append propose
        }
    }
    flag "-b --base" help="Initial full branch/tag ref or commit SHA" {
        arg <BASE>
    }
    flag "-l --ledger" help="Generated patch ledger path" {
        arg <LEDGER>
    }
    flag "-e --exports" help="Generated source-patch export directory" {
        arg <EXPORTS>
    }
    flag "-k --bookkeeping-patch" help="Final tooling patch name" {
        arg <BOOKKEEPING_PATCH>
    }
    flag "-p --bookkeeping-path" help="Additional bookkeeping ownership scope; repeatable" var=#true {
        arg <BOOKKEEPING_SCOPE>
    }
    flag "-a --allow-base" help="Base-drift ownership glob allowed below the patch stack; repeatable" var=#true {
        arg <ALLOW_BASE>
    }
    flag "-r --required-text" help="Required repository text as PATH=TEXT; repeatable" var=#true {
        arg <REQUIRED_TEXT>
    }
    flag "-n --dry-run" help="Validate and show the mutation plan without writes, hooks, or ref updates"
    complete base run="mise run --quiet fork -- __candidates ref" descriptions=#true
    complete upstream_remote run="mise run --quiet fork -- __candidates remote" descriptions=#true
    complete downstream_remote run="mise run --quiet fork -- __candidates remote" descriptions=#true
}
cmd status help="Inspect repository, patch, worktree, check, and operation state"
cmd check help="Check the complete repository or the staged index" {
    flag "-s --staged" help="Check the staged index against an explicit or active patch"
    flag "-p --patch" help="Patch used by staged check; defaults to the active patch" {
        arg <PATCH>
    }
    complete patch run="mise run --quiet fork -- __candidates patch" descriptions=#true
}
cmd patch subcommand_required=#true help="Create, inspect, select, edit, refresh, or finish patches" {
    cmd list help="List the declared series and active patch"
    cmd show help="Show one patch; defaults to the active patch" {
        arg "[NAME]" help="Patch name; defaults to the active patch" required=#false
        complete name run="mise run --quiet fork -- __candidates patch" descriptions=#true
    }
    cmd create help="Record a metadata-only active patch draft" {
        flag "-k --kind" help="Patch layer" required=#true {
            arg <KIND> {
                choices source tooling
            }
        }
        flag "-p --purpose" help="Why this downstream patch exists" required=#true {
            arg <PURPOSE>
        }
        flag "-u --upstream-status" help="Current upstream disposition" required=#true {
            arg <UPSTREAM_STATUS>
        }
        flag "-d --drop-when" help="Objective condition for removing this patch" required=#true {
            arg <DROP_WHEN>
        }
        flag "-s --scope" help="Persistent ownership glob; repeatable" required=#true var=#true {
            arg <SCOPE>
        }
        flag "-C --check" help="Declared check as NAME=COMMAND, where {files} expands to the checked files; repeatable" var=#true {
            arg <CHECKS>
        }
        flag "-g --check-glob" help="Restrict a declared check as NAME=GLOB, defaulting to the patch scope; repeatable" var=#true {
            arg <CHECK_GLOBS>
        }
        flag --check-at help="Evaluate a declared check at its own patch commit as NAME=patch; repeatable" var=#true {
            arg <CHECK_STAGES>
        }
        flag "-n --dry-run" help="Validate and show the mutation plan without writes, hooks, or ref updates"
        arg <NAME> help="Unique patch name"
    }
    cmd select help="Select an existing patch locally" {
        flag "-n --dry-run" help="Validate and show the mutation plan without writes, hooks, or ref updates"
        arg <NAME> help="Existing patch to select"
        complete name run="mise run --quiet fork -- __candidates patch" descriptions=#true
    }
    cmd edit help="Edit metadata or ownership scope" {
        flag "-k --kind" help="Replacement patch layer" {
            arg <KIND> {
                choices source tooling
            }
        }
        flag "-p --purpose" help="Replacement downstream purpose" {
            arg <PURPOSE>
        }
        flag "-u --upstream-status" help="Replacement upstream disposition" {
            arg <UPSTREAM_STATUS>
        }
        flag "-d --drop-when" help="Objective condition for removing this patch" {
            arg <DROP_WHEN>
        }
        flag "-s --set-scope" help="Replace complete ownership scope; repeatable" var=#true {
            arg <SET_SCOPE>
        }
        flag "-a --add-scope" help="Add ownership globs; repeatable" var=#true {
            arg <ADD_SCOPE>
        }
        flag "-r --remove-scope" help="Remove exact ownership globs; repeatable" var=#true {
            arg <REMOVE_SCOPE>
        }
        flag --clear-checks help="Replace the complete check set before adding supplied checks"
        flag "-C --check" help="Declared check as NAME=COMMAND, where {files} expands to the checked files; repeatable" var=#true {
            arg <CHECKS>
        }
        flag "-g --check-glob" help="Restrict a declared check as NAME=GLOB, defaulting to the patch scope; repeatable" var=#true {
            arg <CHECK_GLOBS>
        }
        flag --check-at help="Evaluate a declared check at its own patch commit as NAME=patch; repeatable" var=#true {
            arg <CHECK_STAGES>
        }
        flag "-n --dry-run" help="Validate and show the mutation plan without writes, hooks, or ref updates"
        arg "[NAME]" help="Patch name; defaults to the active patch" required=#false
        complete name run="mise run --quiet fork -- __candidates patch" descriptions=#true
    }
    cmd refresh help="Capture staged, owned, or path-limited changes" {
        flag "-s --staged" help="Explicitly select staged-index capture (the default)"
        flag "-a --all" help="Stage and capture every changed path owned by the patch"
        flag "-p --path" help="Stage and capture an explicit Git pathspec; repeatable" var=#true {
            arg <PATHS>
        }
        flag --rewrite-below help="Refresh a non-top patch and unapply every patch above it. Everyday follow-up work should be a new top patch instead"
        flag "-n --dry-run" help="Validate and show the mutation plan without writes, hooks, or ref updates"
        arg "[NAME]" help="Patch name; defaults to the active patch" required=#false
        complete name run="mise run --quiet fork -- __candidates patch" descriptions=#true
    }
    cmd finish help="Run the full check and clear active state" {
        flag "-n --dry-run" help="Validate and show the mutation plan without writes, hooks, or ref updates"
        arg "[NAME]" help="Patch name; defaults to the active patch" required=#false
        complete name run="mise run --quiet fork -- __candidates patch" descriptions=#true
    }
    cmd remove help="Permanently remove a patch while preserving recovery evidence" {
        flag "-r --reason" help="Auditable operator reason for this transition" required=#true {
            arg <REASON>
        }
        flag "-n --dry-run" help="Validate and show the mutation plan without writes, hooks, or ref updates"
        arg <NAME> help="Patch name"
    }
    cmd disable help="Disable a patch while retaining enough evidence to re-enable it" {
        flag "-r --reason" help="Auditable operator reason for this transition" required=#true {
            arg <REASON>
        }
        flag "-n --dry-run" help="Validate and show the mutation plan without writes, hooks, or ref updates"
        arg <NAME> help="Patch name"
    }
    cmd enable help="Re-enable a previously disabled patch" {
        flag "-n --dry-run" help="Validate and show the mutation plan without writes, hooks, or ref updates"
        arg <NAME> help="Disabled patch name"
    }
}
cmd rebase help="Replay the declared stack onto an exact upstream target" {
    flag "-o --onto" help="Full upstream branch/tag ref or commit SHA" required=#true {
        arg <ONTO>
    }
    flag "-n --dry-run" help="Validate and show the mutation plan without writes, hooks, or ref updates"
    complete onto run="mise run --quiet fork -- __candidates ref" descriptions=#true
}
cmd contract subcommand_required=#true help="Edit declarative repository contracts" {
    cmd edit help="Append contracts or clear and replace the complete contract set" {
        flag --clear help="Clear all existing contracts before adding the supplied values"
        flag "-a --allow-base" help="Add an allowed base-drift ownership glob; repeatable" var=#true {
            arg <ALLOW_BASE>
        }
        flag "-r --required-text" help="Add a required repository contract as PATH=TEXT; repeatable" var=#true {
            arg <REQUIRED_TEXT>
        }
        flag --publish-mode help="Set the repository default publish mode" {
            arg <PUBLISH_MODE> {
                choices rewrite append propose
            }
        }
        flag "-n --dry-run" help="Validate and show the mutation plan without writes, hooks, or ref updates"
    }
}
cmd publish help="Publish the managed branch using the repository default, or an explicit mode" {
    flag --rewrite help="Exact-lease rewrite. Overrides the repository default"
    flag --append help="Keep the previous tip as an ancestor and fast-forward"
    flag --propose help="Push a net-tree proposal branch and open a PR when `gh` is available"
    flag --promote help="Promote an exact proposal to the downstream branch"
    flag --proposal help="Proposal branch, tag, or URL used by --promote" {
        arg <PROPOSAL>
    }
    flag --set-default help="Persist this mode as the repository default, then publish unless --set-default is the only action" {
        arg <SET_DEFAULT> {
            choices rewrite append propose
        }
    }
    flag "-n --dry-run" help="Validate and show the mutation plan without writes, hooks, or ref updates"
}
cmd operation subcommand_required=#true help="Inspect, continue, or abort the current operation" {
    cmd status help="Show the current operation and exact next actions"
    cmd continue help="Resume after operator conflict resolution" {
        flag "-n --dry-run" help="Validate and show the mutation plan without writes, hooks, or ref updates"
    }
    cmd abort help="Restore the recorded old state" {
        flag "-y --yes" help="Confirm destructive restoration of the recorded old state"
        flag "-n --dry-run" help="Validate and show the mutation plan without writes, hooks, or ref updates"
    }
}
cmd instructions help="Print the generated operator and repository contract"
cmd completion help="Generate shell completion registration" {
    arg <SHELL> help="Shell whose registration script should be emitted" {
        choices bash elvish fish nu powershell zsh
    }
}
cmd api subcommand_required=#true help="Use the versioned local JSON API" {
    cmd schema help="Emit JSON Schema 2020-12" {
        flag "-k --kind" help="Schema document to emit" default=bundle {
            arg <KIND> {
                choices bundle manifest invocation response active-state operation
            }
        }
    }
    cmd call help="Read one invocation from stdin and emit one response"
}
cmd __candidates hide=#true {
    arg <KIND> {
        choices patch ref remote
    }
}
